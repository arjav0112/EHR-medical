# ─── LLM Provider Key (required) ─────────────────────────────────────────────

# Google API key — used by ALL agents (Gemini 2.5 Flash)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyAZex5BeNrL6qtgnr94tt_08apYajLdNbA

# ─── App Config ──────────────────────────────────────────────────────────────

# Public base URL (used for SSE callbacks and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: LangSmith Tracing (recommended for debugging agent pipelines) ──

# Set to "true" to enable LangChain tracing via LangSmith
LANGCHAIN_TRACING_V2=false

# LangSmith API key (get one at https://smith.langchain.com)
LANGCHAIN_API_KEY=

# Project name for grouping traces
LANGCHAIN_PROJECT=ehr-copilot

# ─── Optional: Rate Limiting ──────────────────────────────────────────────────

# Requests per minute per IP for /api/session/process
# Defaults to 10 if not set
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
